# ── Supabase ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── API auth (protects /api/* routes) ──
ORCHESTRATOR_SECRET=

# ── AI gateway (chat) — OpenRouter recommended ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://x.com/30piq
OPENROUTER_TITLE=X Growth Brain

# ── Embeddings (for the RAG brain) ──
# Embeddings need a real /embeddings endpoint. OpenRouter does not reliably
# provide one, so point these at OpenAI directly (or any compatible provider).
# If left empty, the brain falls back to lexical retrieval (still works).
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# ── X / TwitterAPI.io (read-only) ──
X_USERNAME=30piq
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io

# ── Telegram control panel ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# ── Public base URL (Vercel) ──
PUBLIC_BASE_URL=

# ── Optional lean tuning (defaults are sensible; profile values win) ──
# LEAN_NICHE=
# LEAN_TWEET_LANGUAGE=en
# LEAN_SOURCE_LIMIT=8
# LEAN_TWEETS_PER_SOURCE=5
