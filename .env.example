# ── Supabase ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── API auth (protects /api/* routes) ──
ORCHESTRATOR_SECRET=

# ── AI gateway (chat) — OpenRouter recommended ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://x.com/30piq
OPENROUTER_TITLE=X Growth Brain

# ── Embeddings (for the RAG brain) ──
# Embeddings need a real /embeddings endpoint. OpenRouter does not reliably
# provide one, so point these at OpenAI directly (or any compatible provider).
# If left empty, the brain falls back to lexical retrieval (still works).
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Media vision (understand the image/gif/video on a tweet) ──
# A multimodal model on your gateway. Default works on OpenRouter.
# Set MEDIA_VISION_MAX=0 to disable vision (keeps media-type-only behaviour).
VISION_MODEL=meta-llama/llama-4-maverick
MEDIA_VISION_MAX=3

# ── X / TwitterAPI.io (read-only) ──
X_USERNAME=30piq
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io

# ── Web search (Serper + SerpAPI; used dynamically with automatic fallback) ──
# Powers deep research AND the daily Reddit/YouTube/web brain enrichment.
# Either key works; having both gives fallback when one is down/rate-limited.
SERPER_API_KEY=
SERPAPI_API_KEY=

# ── Telegram control panel ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# ── Public base URL (Vercel) ──
PUBLIC_BASE_URL=

# ── Optional lean tuning (defaults are sensible; profile values win) ──
# LEAN_NICHE=
# LEAN_TWEET_LANGUAGE=en
# LEAN_SOURCE_LIMIT=8
# LEAN_TWEETS_PER_SOURCE=5
# Cost levers (worker): poll interval, opp cap, and how often to auto-detect
# your published posts (every Nth cycle — lower X reads).
# LEAN_POLL_MINUTES=20
# LEAN_DAILY_OPP_CAP=2
# LEAN_AUTODETECT_EVERY=3
# Real-time layers are OFF by default until matured. Worker sends only the clean
# daily digest. Enable when you want live opportunity cards / the research button.
# All three OFF by default — validate the clean daily digest first, then opt in:
# LEAN_ENABLE_RADAR=false
# LEAN_ENABLE_DEEP_RESEARCH=false
# Daily Reddit/YouTube/web enrichment of the brain (silent; enable after review):
# LEAN_ENABLE_WEB_ENRICH=false
