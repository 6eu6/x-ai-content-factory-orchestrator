SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ORCHESTRATOR_SECRET=

# ── AI gateway (cloud) ──
# اترك OPENAI_BASE_URL فارغًا لـ OpenAI، أو ضعه على OpenRouter:
#   https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
OPENROUTER_REFERER=https://x.com/30piq
OPENROUTER_TITLE=X AI Content Factory

# ── نموذج محلي (Raspberry Pi / Ollama / llama.cpp / vLLM) ──
# لتحويل مهمة معيّنة للنموذج المحلي: اضبط provider='local' في صف
# جدول model_routing_rules. هذه القيم تُستخدم عندها فقط.
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_API_KEY=ollama

# ── X / TwitterAPI.io (read-only) ──
X_BEARER_TOKEN=
X_USERNAME=30piq
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io

# ── GitHub ──
GITHUB_TOKEN=
GITHUB_OWNER=6eu6
GITHUB_DEFAULT_PRIVATE=true

# ── Search ──
SERPER_API_KEY=
SERPAPI_API_KEY=

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# عنوان الاستضافة العام (على Vercel أو Pi). يُستخدم لروابط البوت
# وضبط الـ webhook — لا حاجة لـ VERCEL_URL عند الاستضافة الذاتية.
PUBLIC_BASE_URL=
